{
  "name": "hexaw",
  "version": "0.1.0",
  "description": "Dump WebAssembly to readable HEXAW assembly with exact byte offsets and encodings",
  "type": "module",
  "bin": { "hexaw": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core/hexaw-core.d.ts", "import": "./dist/core/hexaw-core.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22.18" },
  "keywords": ["webassembly", "wasm", "assembly", "assembler", "disassembler", "hexdump", "cli", "hexaw"],
  "author": "Péter Vívó (Pengeszikra)",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Pengeszikra/hexaw.git", "directory": "packages/cli" },
  "homepage": "https://github.com/Pengeszikra/hexaw#readme",
  "bugs": { "url": "https://github.com/Pengeszikra/hexaw/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepack": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/prepublish.mjs"
  }
}

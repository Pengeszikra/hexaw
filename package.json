{
  "name": "hexaw-repository",
  "version": "0.3.0",
  "type": "module",
  "description": "HEXAW CLI and browser Workshop",
  "files": [
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "workshop",
    "packages/cli/src",
    "packages/cli/package.json",
    "packages/cli/tsconfig.json",
    "scripts",
    "test"
  ],
  "author": "Péter Vívó (Pengeszikra)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pengeszikra/hexaw.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run build && npm test && npm run test:package",
    "dev:workshop": "node scripts/serve-workshop.mjs",
    "preshell": "npm run build",
    "shell": "node packages/cli/dist/cli.js --interactive",
    "pack:cli": "npm pack --workspace packages/cli --pack-destination artifacts",
    "publish:all": "node scripts/publish.mjs",
    "publish:cli": "npm publish --workspace packages/cli --access public"
  },
  "devDependencies": {
    "@pengeszikra/typescript": "7.1.0-pipeline.1",
    "@types/node": "22.18.0",
    "wabt": "1.0.39"
  },
  "license": "MIT"
}
